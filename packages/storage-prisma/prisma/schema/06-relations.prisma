// ───────────── Relations ─────────────

model Relationship {
  worldId                String       @map("world_id") @db.Uuid
  sourceId               String       @map("source_id") @db.Uuid
  targetId               String       @map("target_id") @db.Uuid
  trust                  Int          @default(30) @db.SmallInt
  affection              Int          @default(0) @db.SmallInt
  rivalry                Int          @default(0) @db.SmallInt
  respect                Int          @default(50) @db.SmallInt
  fear                   Int          @default(0) @db.SmallInt
  attraction             Int          @default(0) @db.SmallInt
  alliance               Int          @default(0) @db.SmallInt
  extraAxes              Json         @default("{}") @map("extra_axes")
  acquaintance           Acquaintance @default(known_of)
  firstMetEventId        String?      @map("first_met_event_id") @db.Uuid
  lastInteractionEventId String?      @map("last_interaction_event_id") @db.Uuid
  interactionCount       Int          @default(0) @map("interaction_count")
  labels                 String[]     @default([])
  updatedAt              DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  source               Character @relation("RelSource", fields: [sourceId], references: [id])
  target               Character @relation("RelTarget", fields: [targetId], references: [id])
  firstMetEvent        Event?    @relation("FirstMet", fields: [firstMetEventId], references: [id])
  lastInteractionEvent Event?    @relation("LastInteraction", fields: [lastInteractionEventId], references: [id])

  @@id([sourceId, targetId])
  @@map("relationship")
}

model RelationshipSnapshot {
  epochId      String       @map("epoch_id") @db.Uuid
  sourceId     String       @map("source_id") @db.Uuid
  targetId     String       @map("target_id") @db.Uuid
  trust        Int          @db.SmallInt
  affection    Int          @db.SmallInt
  rivalry      Int          @db.SmallInt
  respect      Int          @db.SmallInt
  fear         Int          @db.SmallInt
  attraction   Int          @db.SmallInt
  alliance     Int          @db.SmallInt
  extraAxes    Json         @map("extra_axes")
  acquaintance Acquaintance

  epoch Epoch @relation(fields: [epochId], references: [id])

  @@id([epochId, sourceId, targetId])
  @@map("relationship_snapshot")
}

model CharacterState {
  characterId String           @map("character_id") @db.Uuid
  epochId     String           @map("epoch_id") @db.Uuid
  energy      Int?             @db.SmallInt
  morale      Int?             @db.SmallInt
  popularity  Int?             @db.SmallInt
  influence   Int?             @db.SmallInt
  reputation  Int?             @db.SmallInt
  credits     Int?
  status      CharacterStatus?
  mood        Json             @default("{}")
  scores      Json             @default("{}")

  character Character @relation(fields: [characterId], references: [id])
  epoch     Epoch     @relation(fields: [epochId], references: [id])

  @@id([characterId, epochId])
  @@map("character_state")
}

model CreditLedger {
  id          String       @id @db.Uuid
  characterId String       @map("character_id") @db.Uuid
  epochId     String?      @map("epoch_id") @db.Uuid
  eventId     String?      @map("event_id") @db.Uuid
  amount      Int
  category    String
  source      CreditSource
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  character Character @relation(fields: [characterId], references: [id])
  epoch     Epoch?    @relation(fields: [epochId], references: [id])
  event     Event?    @relation(fields: [eventId], references: [id])

  @@map("credit_ledger")
}

model ScoreEntry {
  id          String    @id @db.Uuid
  characterId String    @map("character_id") @db.Uuid
  epochId     String    @map("epoch_id") @db.Uuid
  eventId     String    @map("event_id") @db.Uuid
  score       ScoreName
  weight      Float     @db.Real
  impact      Float     @db.Real
  ruleId      String    @map("rule_id")

  event Event @relation(fields: [eventId], references: [id])

  @@map("score_entry")
}

