// ───────────── Relations ─────────────

model Relationship {
  worldId                String       @map("world_id") @db.Uuid
  sourceId               String       @map("source_id") @db.Uuid
  targetId               String       @map("target_id") @db.Uuid
  trust                  Float        @default(30) @db.DoublePrecision
  affection              Float        @default(0) @db.DoublePrecision
  rivalry                Float        @default(0) @db.DoublePrecision
  respect                Float        @default(50) @db.DoublePrecision
  fear                   Float        @default(0) @db.DoublePrecision
  attraction             Float        @default(0) @db.DoublePrecision
  alliance               Float        @default(0) @db.DoublePrecision
  extraAxes              Json         @default("{}") @map("extra_axes")
  acquaintance           Acquaintance @default(known_of)
  firstMetEventId        String?      @map("first_met_event_id") @db.Uuid
  lastInteractionEventId String?      @map("last_interaction_event_id") @db.Uuid
  interactionCount       Int          @default(0) @map("interaction_count")
  labels                 String[]     @default([])
  updatedAt              DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  source               Character @relation("RelSource", fields: [sourceId], references: [id])
  target               Character @relation("RelTarget", fields: [targetId], references: [id])
  firstMetEvent        Event?    @relation("FirstMet", fields: [firstMetEventId], references: [id])
  lastInteractionEvent Event?    @relation("LastInteraction", fields: [lastInteractionEventId], references: [id])

  @@id([sourceId, targetId])
  @@map("relationship")
}

model RelationshipSnapshot {
  epochId      String       @map("epoch_id") @db.Uuid
  sourceId     String       @map("source_id") @db.Uuid
  targetId     String       @map("target_id") @db.Uuid
  trust        Float        @db.DoublePrecision
  affection    Float        @db.DoublePrecision
  rivalry      Float        @db.DoublePrecision
  respect      Float        @db.DoublePrecision
  fear         Float        @db.DoublePrecision
  attraction   Float        @db.DoublePrecision
  alliance     Float        @db.DoublePrecision
  extraAxes    Json         @map("extra_axes")
  acquaintance Acquaintance
  interactionCount       Int      @default(0) @map("interaction_count")
  firstMetEventId        String?  @map("first_met_event_id") @db.Uuid
  lastInteractionEventId String?  @map("last_interaction_event_id") @db.Uuid
  labels                 String[] @default([])

  epoch Epoch @relation(fields: [epochId], references: [id])

  @@id([epochId, sourceId, targetId])
  @@map("relationship_snapshot")
}

model CharacterState {
  characterId String           @map("character_id") @db.Uuid
  epochId     String           @map("epoch_id") @db.Uuid
  energy      Float?           @db.DoublePrecision
  morale      Float?           @db.DoublePrecision
  popularity  Float?           @db.DoublePrecision
  influence   Float?           @db.DoublePrecision
  reputation  Float?           @db.DoublePrecision
  credits     Int?
  status      CharacterStatus?
  mood        Json             @default("{}")
  scores      Json             @default("{}")
  runtime     Json             @default("{}")

  character Character @relation(fields: [characterId], references: [id])
  epoch     Epoch     @relation(fields: [epochId], references: [id])

  @@id([characterId, epochId])
  @@map("character_state")
}

model CreditLedger {
  id          String       @id @db.Uuid
  characterId String       @map("character_id") @db.Uuid
  epochId     String?      @map("epoch_id") @db.Uuid
  eventId     String?      @map("event_id") @db.Uuid
  amount      Int
  category    String
  source      CreditSource
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  character Character @relation(fields: [characterId], references: [id])
  epoch     Epoch?    @relation(fields: [epochId], references: [id])
  event     Event?    @relation(fields: [eventId], references: [id])

  @@map("credit_ledger")
}

model ScoreEntry {
  id          String    @id @db.Uuid
  characterId String    @map("character_id") @db.Uuid
  epochId     String    @map("epoch_id") @db.Uuid
  eventId     String    @map("event_id") @db.Uuid
  score       ScoreName
  weight      Float
  impact      Float
  ruleId      String    @map("rule_id")

  event Event @relation(fields: [eventId], references: [id])

  @@map("score_entry")
}
