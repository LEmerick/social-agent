{
  "name": "@ai-reality/engine",
  "version": "0.0.0",
  "private": true,
  "description": "Domaine, services et scheduler du moteur AI Reality (aucune dépendance base ni LLM)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./llm": {
      "types": "./dist/llm/index.d.ts",
      "default": "./dist/llm/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --root ../.. packages/engine"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "fast-check": "^4.10.2",
    "vitest": "^5.0.3"
  }
}
